<?xml version="1.0" encoding="utf-8"?>
<com.example.gestiondecompras.views.GestureDrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    tools:openDrawer="start">

    <!-- CONTENIDO PRINCIPAL -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_card"
        tools:context=".activities.MainActivity">

        <!-- Toolbar Transparente -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            app:navigationIcon="@drawable/ic_menu"
            app:title="" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="?attr/actionBarSize"
            android:layout_marginBottom="60dp"
            android:fillViewport="true"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp">

                <!-- CARD PRINCIPAL -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/background_card"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:id="@+id/tvGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_greeting_placeholder"
                            android:textColor="@color/gray_dark"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="Hola, Gustavo" />

                        <TextView
                            android:id="@+id/tvHeroSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/dashboard_subtitle"
                            android:textColor="@color/gray"
                            android:textSize="14sp"
                            tools:text="Resumen del día" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/total_pendiente"
                            android:textColor="@color/gray"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvTotalPendiente"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="RD$ 0.00"
                            android:textColor="@color/primary_color"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            tools:text="RD$ 12,500.00" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTrend"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/dashboard_trend_placeholder"
                            android:textColor="@color/dashboard_card_income"
                            app:chipBackgroundColor="@color/dashboard_trend_bg"
                            app:chipIcon="@drawable/ic_trending_up"
                            app:chipIconTint="@color/dashboard_card_income"
                            app:chipStrokeColor="@android:color/transparent"
                            tools:text="Subió RD$ 2,100" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SECCIÓN DE ESTADÍSTICAS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardTotalPendiente"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/background_card"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_icon_badge_blue"
                                android:padding="8dp"
                                android:src="@drawable/ic_list"
                                android:tint="@color/primary_color" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/total_pendiente"
                                android:textColor="@color/gray"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvTotalPendienteCard"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="RD$ 0.00"
                                android:textColor="@color/gray_dark"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="RD$ 12,500.00" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardTotalPagado"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/background_card"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_icon_badge_green"
                                android:padding="8dp"
                                android:src="@drawable/ic_credit_card"
                                android:tint="@color/success_color" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Total pagado"
                                android:textColor="@color/gray"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvTotalPagado"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="RD$ 0.00"
                                android:textColor="@color/gray_dark"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="RD$ 5,900.00" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPedidosAtrasados"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/background_card"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_icon_badge_red"
                                android:padding="8dp"
                                android:src="@drawable/ic_trending_down"
                                android:tint="@color/error_color" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/pedidos_atrasados"
                                android:textColor="@color/gray"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvPedidosAtrasados"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="0"
                                android:textColor="@color/gray_dark"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="2" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardGananciaEsperada"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/background_card"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_icon_badge_green"
                                android:padding="8dp"
                                android:src="@drawable/ic_trending_up"
                                android:tint="@color/dashboard_card_income" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/ganancia_esperada"
                                android:textColor="@color/gray"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvGananciaEsperadaCard"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="RD$ 0.00"
                                android:textColor="@color/gray_dark"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="RD$ 5,900.00" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- GASTOS DEL MES -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGastosMes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/background_card"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_badge_red"
                            android:padding="9dp"
                            android:src="@drawable/ic_wallet"
                            android:tint="@color/error_color" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/gastos_dashboard_title"
                                android:textColor="@color/gray"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvGastosMes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="RD$ 0.00"
                                android:textColor="@color/error_color"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="RD$ 5,900.00" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ACCIONES RÁPIDAS -->
                <TextView
                    android:id="@+id/tvAccionesRapidas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/acciones_rapidas"
                    android:textColor="@color/gray_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:id="@+id/chipGroupActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingEnd="8dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/chipNuevoPedido"
                            android:layout_width="100dp"
                            android:layout_height="110dp"
                            android:layout_marginEnd="12dp"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="@color/background_card"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="1dp"
                            app:strokeColor="@color/card_stroke"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_icon_badge_blue"
                                    android:padding="12dp"
                                    android:src="@drawable/ic_add_circle"
                                    android:tint="@color/primary_color" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:gravity="center"
                                    android:text="@string/nuevo_pedido"
                                    android:textColor="@color/gray_dark"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/chipListaPedidos"
                            android:layout_width="100dp"
                            android:layout_height="110dp"
                            android:layout_marginEnd="12dp"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="@color/background_card"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="1dp"
                            app:strokeColor="@color/card_stroke"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_icon_badge_blue"
                                    android:padding="12dp"
                                    android:src="@drawable/ic_list"
                                    android:tint="@color/primary_color" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:gravity="center"
                                    android:text="@string/ver_pedidos"
                                    android:textColor="@color/gray_dark"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/chipCalendario"
                            android:layout_width="100dp"
                            android:layout_height="110dp"
                            android:layout_marginEnd="12dp"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="@color/background_card"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="1dp"
                            app:strokeColor="@color/card_stroke"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_icon_badge_blue"
                                    android:padding="12dp"
                                    android:src="@drawable/ic_calendar"
                                    android:tint="@color/primary_color" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:gravity="center"
                                    android:text="@string/calendario"
                                    android:textColor="@color/gray_dark"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/chipClientes"
                            android:layout_width="100dp"
                            android:layout_height="110dp"
                            android:layout_marginEnd="12dp"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="@color/background_card"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="1dp"
                            app:strokeColor="@color/card_stroke"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_icon_badge_blue"
                                    android:padding="12dp"
                                    android:src="@drawable/ic_people"
                                    android:tint="@color/primary_color" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:gravity="center"
                                    android:text="@string/clientes"
                                    android:textColor="@color/gray_dark"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/chipReportes"
                            android:layout_width="100dp"
                            android:layout_height="110dp"
                            android:layout_marginEnd="12dp"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="@color/background_card"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="1dp"
                            app:strokeColor="@color/card_stroke"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_icon_badge_blue"
                                    android:padding="12dp"
                                    android:src="@drawable/ic_trending_up"
                                    android:tint="@color/primary_color" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:gravity="center"
                                    android:text="@string/dashboard_reports"
                                    android:textColor="@color/gray_dark"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/chipTarjetas"
                            android:layout_width="100dp"
                            android:layout_height="110dp"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="@color/background_card"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="1dp"
                            app:strokeColor="@color/card_stroke"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_icon_badge_blue"
                                    android:padding="12dp"
                                    android:src="@drawable/ic_credit_card"
                                    android:tint="@color/primary_color" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:gravity="center"
                                    android:text="@string/tarjeta"
                                    android:textColor="@color/gray_dark"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- LISTA DE PRÓXIMOS PEDIDOS -->
                <TextView
                    android:id="@+id/tvProximosTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/proximos_pedidos"
                    android:textColor="@color/gray_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProximosSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_next_orders_subtitle"
                    android:textColor="@color/gray"
                    android:textSize="14sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvProximosPedidos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="240dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <LinearLayout
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_list"
                        android:tint="@color/gray_light" />

                    <TextView
                        android:id="@+id/tvNoPedidos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/no_hay_pedidos_proximos"
                        android:textColor="@color/gray"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- BANNER ADS -->
        <com.google.android.gms.ads.AdView
            android:id="@+id/adView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
